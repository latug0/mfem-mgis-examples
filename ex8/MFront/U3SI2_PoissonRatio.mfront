@Parser MaterialLaw;
@Material U3SI2;
@Law PoissonRatio;
@Author FAUQUE Jules;
@Date 06/25;

@Description {
  Coefficient de Poisson venant de "AIEA TECDOC SERIES Analysis of Options and Experimental Examination of Fuels for Water Cooled Reactors with Increased Accident Tolerance (ACTOF) - Final Report of a Coordinated Research Project"
  voir https://www-pub.iaea.org/MTCD/Publications/PDF/TE-1921web.pdf
}

// output of law
@Output nu;
nu.setGlossaryName("PoissonRatio");

// input of law

// variables bounds

// constants

// parameters

@Function {
  nu = 0.18;
}  // end of Function
