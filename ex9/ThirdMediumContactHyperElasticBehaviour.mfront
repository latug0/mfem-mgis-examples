@DSL DefaultFiniteStrainDSL{
automatic_declaration_of_the_temperature_as_first_external_state_variable:
  false
};
@Behaviour ThirdMediumContactHyperElasticBehaviour;
@Author T. Helfer;
@Date 21/03/2023;
@Description{
  "W = psi_c * [K/2 (ln J)^2+mu/2*(J^{-(2/3)}*tr(C)-3)] + psi_p * [p J]"
  "W = psi_c * [K/8 (ln I3)^2 + (mu / 2) * (I1 / I3^(1/3) - 3)]  + psi_p * [p I3^2]"
}

@MaterialProperty stress K;
K.setGlossaryName("BulkModulus");
@MaterialProperty stress mu;
mu.setGlossaryName("ShearModulus");

@LocalVariable StiffnessTensor dS_dC;

//@AuxiliaryStateVariable stress W;
@PredictionOperator<DS_DC> {
  constexpr auto id = Stensor::Id();
  const auto C = computeRightCauchyGreenTensor(F1);
  // invariants and derivatives
  const auto I1 = trace(C);
  const auto I3 = det(C);
  const auto dI3_dC = computeDeterminantDerivative(C);
  const auto d2I3_dCdC = computeDeterminantSecondDerivative(C);
  const auto iJb        =  1/cbrt(I3);
  const auto iJb2       =  power<2>(iJb);
  const auto iJb4       =  iJb2*iJb2;
  const auto diJb_dI3   = -iJb4/3;
  const auto diJb_dC    = diJb_dI3*dI3_dC;
  const auto ln_I3 = log(I3);
  const auto d2I3_dC2 = computeDeterminantSecondDerivative(C);
  const auto iJb7 = iJb4 * power<3>(iJb);
  const auto d2iJb_dI32 = 4 * iJb7 / 9;
  const auto d2iJb_dC2 = d2iJb_dI32 * (dI3_dC ^ dI3_dC) + diJb_dI3 * d2I3_dC2;
  const auto d2I1b_dC2 = (id ^ diJb_dC) + (diJb_dC ^ id) + I1 * d2iJb_dC2;

  Dt = 2 * ((K / (4 * I3)) * (ln_I3 * d2I3_dCdC +
                              (1 / I3 - ln_I3 / I3) * (dI3_dC ^ dI3_dC)) +
            (mu / 2) * d2I1b_dC2);
}

@Integrator {
  constexpr auto id = Stensor::Id();
  const auto J = det(F1);
  if (J < 0) {
    return false;
  }
  const auto C = computeRightCauchyGreenTensor(F1);
  // invariants and derivatives
  const auto I1 = trace(C);
  const auto I3 = J * J;
  const auto dI3_dC = computeDeterminantDerivative(C);
  const auto d2I3_dCdC = computeDeterminantSecondDerivative(C);
  const auto iJb        =  1/cbrt(I3);
  const auto iJb2       =  power<2>(iJb);
  const auto iJb4       =  iJb2*iJb2;
  const auto diJb_dI3   = -iJb4/3;
  const auto diJb_dC    = diJb_dI3*dI3_dC;
  const auto dI1b_dC    =  iJb*id+I1*diJb_dC;
  const auto ln_I3 = log(I3);
  // S = 2 dW_dC
  const StressStensor S =
      2*((K / (4 * I3)) * ln_I3 * dI3_dC + (mu / 2) * (dI1b_dC));
      
  // W = (K/2)*power<2>(log(power<2>(I3))) + (mu/2)*(1/cbrt(power<2>(power<2>(I3)))*I1-3);
  //w = (K/2)*power<2>(log(power<2>(I3))) + (mu/2)*(1/cbrt(power<2>(power<2>(I3)))*I1-3);
  sig = convertSecondPiolaKirchhoffStressToCauchyStress(S, F1);
  if (computeTangentOperator_) {
    const auto d2I3_dC2 = computeDeterminantSecondDerivative(C);
    const auto iJb7       =  iJb4*power<3>(iJb);
    const auto d2iJb_dI32 = 4*iJb7/9;
    const auto d2iJb_dC2  =
      d2iJb_dI32*(dI3_dC^dI3_dC)+ diJb_dI3*d2I3_dC2;
    const auto d2I1b_dC2    =
      (id^diJb_dC)+(diJb_dC^id)+I1*d2iJb_dC2;

    dS_dC = 2*((K / (4 * I3)) * (ln_I3 * d2I3_dCdC +
                              (1 / I3 - ln_I3 / I3) * (dI3_dC ^ dI3_dC)) +
            (mu / 2) * d2I1b_dC2);
  }
}


@TangentOperator<DS_DC> {
  static_cast<void>(smt);
  Dt = dS_dC;
}