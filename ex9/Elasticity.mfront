@Behaviour Elasticity;
@Author Helfer Thomas;
@Date 11 / 12 / 06;
@Description{
  A very first test (the most simple one in fact).
}

@Parameter stress λ = 75e9;
λ.setGlossaryName("FirstLameCoefficient");
@Parameter stress μ = 63e9;
μ.setGlossaryName("ShearModulus");

@PredictionOperator {
  static_cast<void>(smt);
  Dt = λ ⋅ (I₂ ⊗ I₂) + 2 ⋅ μ ⋅ I₄;
}

@Integrator{
  const auto ε = εᵗᵒ + Δεᵗᵒ;
  σ = λ ⋅ trace(ε) ⋅ I₂ + 2 ⋅ μ ⋅ ε;
}

@TangentOperator {
  static_cast<void>(smt);
  Dt = λ ⋅ (I₂ ⊗ I₂) + 2 ⋅ μ ⋅ I₄;
}
