 quadratic = FAUX; 
   
 'OPTION' 'DIME' 2; 
   
 'SI' quadratic; 
 *'OPTION' 'ELEM' 'TRI6'; 
 'OPTION' 'ELEM' 'TRI6'; 
 'SINON'; 
 'OPTION' 'ELEM' 'TRI3'; 
 'FINSI'; 
   
 * Dimension 
 * --------- 
 factor = 1.0; 
   
 * Poutre 
 * ------ 
 length  = 2.0 '*' factor; 
 width   = 0.1 '*' factor; 
   
 * Distance poutre - origine 
 hpo     = 0.55 '*' factor; 
   
 * Premier corps (en haut à gauche) 
 * -------------------------------- 
 dxB     = 0.25 '*' length; 
 dyB     = 6.0 '*' width; 
   
 * Distance poutre - premier corps 
 hpb = 0.05 '*' length; 
   
 * Deuxième corps (en bas à droite) 
 * -------------------------------- 
 diam    = 0.3 '*' length; 
 hcb     = 2.0 '*' width; 
   
 * Distance deuxième corps - origine 
 dpb     = 1.0 '*' length; 
   
   
   
 d1 = 0.01 * length; 
 eps = d1 * 1e-6; 
 radius  = diam '/' 2.0; 
   
 'DENSITE' d1; 
   
 * Construction de la poutre 
 * ========================= 
   
 * Points principaux de la poutre 
 POU00     = (0. hpo); 
 POU01     = (length hpo); 
 POU02     = (length (hpo+width)); 
 POU03     = (0. (hpo+width)); 
   
 * Test logique 
 BOOL01 = (diam '+' dpb) >EG length; 
   
 SI BOOL01; 
 POU04     = ((length-diam) hpo); 
 POU05     = (dxB (hpo+width)); 
   
 LPOUB     = 'DROITE' POU00 POU04; 
 LPOUI     = 'DROITE' POU04 POU01; 
 LPOUD     = 'DROITE' POU01 POU02; 
 LPOUH     = 'DROITE' POU02 POU05; 
 LPOUV     = 'DROITE' POU05 POU03; 
 LPOUG     = 'DROITE' POU03 POU00; 
   
   
 POUTRE = 'SURFACE' (LPOUB 'ET' LPOUI 'ET' LPOUD 'ET' LPOUH 'ET' LPOUV 'ET' LPOUG); 
   
 SINON; 
 POU04     = (dpb hpo); 
 POU06     = ((dpb+diam) hpo); 
 POU05     = (dxB (hpo+width)); 
   
 LPOUB     = 'DROITE' POU00 POU04; 
 LPOUI     = 'DROITE' POU04 POU06; 
 LPOUK     = 'DROITE' POU06 POU01; 
 LPOUD     = 'DROITE' POU01 POU02; 
 LPOUH     = 'DROITE' POU02 POU05; 
 LPOUV     = 'DROITE' POU05 POU03; 
 LPOUG     = 'DROITE' POU03 POU00; 
   
   
 POUTRE = 'SURFACE' (LPOUB 'ET' LPOUI 'ET' LPOUV 'ET' LPOUD 'ET' LPOUK 'ET' LPOUH 'ET' LPOUG); 
 FINSI; 
   
   
 * Construction du corps 2 
 * ======================= 
   
 SI BOOL01; 
   
 PBOD201  = ((length-diam) 0.); 
 PBOD202  = (length 0.); 
 PBOD203  = (length hcb); 
 PBOD204  = ((length-diam) hcb); 
 PBOD205  = ((length-radius) hcb); 
   
 SINON; 
   
 PBOD201  = (dpb 0.); 
 PBOD202  = ((dpb+diam) 0.); 
 PBOD203  = ((dpb+diam) hcb); 
 PBOD204  = (dpb hcb); 
 PBOD205  = ((dpb+radius) hcb); 
   
 FINSI; 
   
   
   
 LBOD2B   = 'DROITE' PBOD201 PBOD204; 
 LBOD2H   = 'CERCLE' 'ROTA' ((-1.0)*180.0) PBOD204 PBOD205; 
 LBOD2D   = 'DROITE' PBOD203 PBOD202; 
 LBOD2G   = 'DROITE' PBOD202 PBOD201; 
   
 ELIM (LBOD2H 'ET' LBOD2D) (0.001*factor); 
 BODY2 = 'SURFACE' (LBOD2B 'ET' LBOD2D 'ET' LBOD2H 'ET' LBOD2G); 
   
   
 * Construction du corps 1 
 * ======================= 
   
 ybod = hpo '+' width '+ 'hpb '+' dyB; 
 pden = (dyB '*' dyB) '-' (dxB '*' dxB); 
 pcer = ((pden) '/' (2.0 '*' dxB)); 
 LIST   pcer; 
 PBOD101  = (0. (ybod-dyB)); 
 PBOD102  = (dxB ybod); 
 PBOD103  = (0. ybod); 
   
 PBOD104  = (((-1.0)*pcer) ybod); 
   
 LBOD1D   = 'CERCLE' PBOD101 PBOD104 PBOD102; 
 LBOD1G   = 'DROITE' PBOD101 PBOD103; 
 LBOD1H   = 'DROITE' PBOD103 PBOD102; 
   
 BODY1 = 'SURFACE' (LBOD1D 'ET' LBOD1G 'ET' LBOD1H); 
   
 * Construction du void 1 
 * ====================== 
   
 LVOI1G   = 'DROITE' POU03 PBOD101; 
 LVOI1D   = 'DROITE' PBOD102 POU05; 
   
 VOID1 = 'SURFACE' (LBOD1D 'ET' LVOI1G 'ET' LPOUV 'ET' LVOI1D); 
   
   
 * Construction du void 2 
 * ====================== 
 *PBOD204 -- PBOD203 
 *POU04 POU01; 
   
 LVOI2G   = 'DROITE' PBOD204 POU04; 
   
 SI BOOL01; 
 LVOI2D = 'DROITE' POU01 (length hcb); 
 SINON; 
 LVOI2D = 'DROITE' POU06 ((dpb+diam) hcb); 
 FINSI; 
   
 TRAC (LVOI2G ET LPOUI ET LBOD2H ET LVOI2D); 
   
 SEGM = LVOI2G ET LPOUI ET LBOD2H ET LVOI2D; 
   
 ELIM SEGM eps; 
 *TRAC SEGM; 
 VOID2 = 'SURFACE' SEGM; 
   
 TRAC (POUTRE 'ET' VOID1 'ET' VOID2); 
   
 meshes = 'TABLE'; 
 ***************************** 
 * Sortie du domaine Poutre  * 
 ***************************** 
 * Domaine - Poutre 
 meshes. 'POUTRE'    = 'INVERSE' POUTRE; 
 * Boundary - Poutre 
 meshes. 'LPOUB'     = LPOUB; 
 meshes. 'LPOUI'     = LPOUI; 
 meshes. 'LPOUD'     = LPOUD; 
 meshes. 'LPOUH'     = LPOUH; 
 meshes. 'LPOUV'     = LPOUV; 
 meshes. 'LPOUG'     = LPOUG; 
 * Point - Poutre 
 meshes. 'POU02'     = POU02; 
 meshes. 'POU03'     = POU03; 
 meshes. 'POU01'     = POU01; 
   
 SI (NON BOOL01); 
 meshes. 'LPOUK'     = LPOUK; 
 FINSI; 
   
 * Boundary - Body 2 
 meshes. 'LBOD2H'     = LBOD2H; 
 meshes. 'LBOD2D'     = LBOD2D; 
 meshes. 'LBOD2G'     = LBOD2G; 
   
 ***************************** 
 * Sortie du domaine Body1   * 
 ***************************** 
 * Boundary - Body 1 
 meshes. 'LBOD1D'     = LBOD1D; 
   
 ***************************** 
 * Sortie du domaine Void1   * 
 ***************************** 
 * Domaine - VOid 1 
 meshes. 'VOID1'    = VOID1; 
 * Boundary - Void 1 
 meshes. 'LVOI1G'     = LVOI1G; 
 meshes. 'LVOI1D'     = LVOI1D; 
   
   
 ***************************** 
 * Sortie du domaine Void2   * 
 ***************************** 
 * Domaine - Void 2 
 meshes. 'VOID2'    = VOID2; 
 * Boundary - Void 2 
 meshes. 'LVOI2G'     = LVOI2G; 
 meshes. 'LVOI2D'     = LVOI2D; 
   
 'OPTION' 'SORTIR' 'mesh.med'; 
 'SORTIR' 'MED' meshes; 
 'FIN'; 
