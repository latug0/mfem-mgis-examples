// -----------------------------------------------------------------------------
// Parameters & Geometry for 3D Hertz Contact (Hemisphere on Flat)
//
// Built from the 2D case by revolving the same x-y profile 90 degrees about the
// y-axis. Because of the two symmetry planes (x = 0 and z = 0) the model is one
// quarter of the hemisphere (i.e. an octant of the sphere) on a quarter-disc
// foundation. All three regions are generated by extruding (revolving) the 2D
// profile in n_theta layers, so the mesh is conforming by construction and
// nodes match one-to-one across the foundation/void/indenter interfaces.
//   - VOID:       hexahedra (wedges where the element touches the axis)
//   - FOUNDATION: prisms (wedges), a few tets/pyramids on the axis
//   - INDENTER:   prisms (wedges), a few tets/pyramids on the axis
// -----------------------------------------------------------------------------
R  = 1; // Indenter (sphere) radius
W  = 2*R;  // Radius of the (quarter-disc) foundation, using symmetry
W = Max(W,R);
Hf = 0.9*R;  // Foundation/plane depth
void_gap = 0.01*R; // Gap between indenter and foundation
arc_ratio = 0.5; // Percentage of arc (polar angle, 0..90 deg) covered by third Medium

lc = 0.03;  // Mesh characteristic length near the contact
lc_far = 4*lc; // Mesh characteristic length away from the contact
n_contact = 45; // Number of nodes along the contact profile (radial direction)
N = n_contact - 1; // Number of elements along the contact profile
n_theta = 35; // Number of elements in the azimuthal direction (0 to 90 deg)
n_void_thickness = 2; // Number of nodes (elements will be one less) in the void (along the thickness) 
// -----------------------------------------------------------------------------
// 2D profile in the x-y plane (z = 0), identical to the 2D test case
// -----------------------------------------------------------------------------
// Foundation
Point(1) = {0, -Hf, 0, lc_far};
Point(2) = {W, -Hf, 0, lc_far};
Point(3) = {W, 0, 0, lc_far};
Point(4) = {R*Sin(arc_ratio*Pi/2),0,0,lc};
Point(5) = {0, 0, 0, lc};

Line(1) = {1, 2}; // FOUND_BOT
Line(2) = {2, 3}; // FOUND_RIGHT
Line(3) = {3, 4}; // FOUND_TOP

// --- Align contact-patch nodes with the spherical cap so void elements are
// vertical. Points are placed at the projected arc positions and chained into
// a continuous list of 1-element segments.
pt_list[0] = 4;
For i In {1 : N-1}
    // Angle uniformly decreases from max contact angle down to 0
    theta = (arc_ratio*Pi/2) * (1 - i/N);
    x = R*Sin(theta);
    Point(100+i) = {x, 0, 0, lc};
    pt_list[i] = 100+i;
EndFor
pt_list[N] = 5;

line4_list[] = {};
For i In {1 : N}
    Line(400+i) = {pt_list[i-1], pt_list[i]};
    line4_list[i-1] = 400+i;
    Transfinite Curve {400+i} = 2; // 2 nodes per segment (1 element)
EndFor
// --------------------------------------------------------------------

Line(5) = {5, 1}; // SYM_FOUND (x=0 axis)

Curve Loop(1) = {1, 2, 3, line4_list[], 5};
Plane Surface(1) = {1};

// Void (Third Medium Gap)
Point(6) = {0,void_gap,0,lc};
Point(7) = {R*Sin(arc_ratio*Pi/2) , void_gap + R*(1-Cos(arc_ratio*Pi/2)), 0, lc};
Point(8) = {R, void_gap+R, 0, lc_far};
Point(9) = {0, R+void_gap, 0, lc_far};

Circle(6) = {6, 9, 7};    // IND_CONTACT (Arc)
Circle(7) = {7, 9, 8};    // IND_BOT (Arc)

Line(8) = {5,6}; // VOID_LEFT (on the revolution axis)
Line(9) = {7, 4}; // VOID_RIGHT

Curve Loop(2) = {8, 6, 9, line4_list[]};
Plane Surface(2) = {2};

// Indenter
Line(10) = {8, 9}; // IND_TOP
Line(11) = {9, 6}; // SYM_IND (on the revolution axis)

Curve Loop(3) = {6, 7, 10, 11};
Plane Surface(3) = {3};

// -----------------------------------------------------------------------------
// Meshing controls on the profile (same as 2D)
// -----------------------------------------------------------------------------
Transfinite Curve {6} = n_contact; // Contact arc of the indenter
Transfinite Curve {8,9} = n_void_thickness;       // 1 element through the void thickness
Transfinite Surface {2} = {5, 6, 7, 4};
Recombine Surface {2};

// -----------------------------------------------------------------------------
// Revolve the whole profile 90 deg about the y-axis (x -> z, so the model lives
// in x >= 0, z >= 0), all three regions in one Extrude with n_theta layers:
//  - Void: structured hexahedra (prisms/wedges touching the axis)
//  - Foundation & Indenter: the 2D triangles become prisms (wedges)
// Everything is generated by extrusion, so the mesh is conforming by
// construction (no 3D Delaunay fill, no pyramids, no tets except degenerate
// elements on the axis).
// -----------------------------------------------------------------------------
Extrude {{0,1,0}, {0,0,0}, -Pi/2} { Surface{1,2,3}; Layers{n_theta}; Recombine; }

Coherence;

// -----------------------------------------------------------------------------
// Physical Groups Output
// -----------------------------------------------------------------------------
eps = 1e-6;
z_cap = void_gap + R*(1-Cos(arc_ratio*Pi/2)); // height of the void at its outer edge
r_c   = R*Sin(arc_ratio*Pi/2);                // radius of the contact patch


// Volumes (selected by bounding box so the group does not depend on tag numbering)
fnd[] = Volume In BoundingBox {-eps, -Hf-eps, -eps, W+eps, eps, W+eps};
vod[] = Volume In BoundingBox {-eps, -eps, -eps, r_c+eps, z_cap+eps, r_c+eps};
ind[] = Volume In BoundingBox {-eps, void_gap-eps, -eps, R+eps, R+void_gap+eps, R+eps};

Physical Volume("FOUNDATION", 100) = {fnd[]};
Physical Volume("VOID", 101) = {vod[]};
Physical Volume("INDENTER", 102) = {ind[]};

// Surfaces
// Symmetry plane x = 0
sxf[] = Surface In BoundingBox {-eps, -Hf-eps, -eps, eps, eps, W+eps};
sxv[] = Surface In BoundingBox {-eps, -eps, -eps, eps, z_cap+eps, r_c+eps};
sxi[] = Surface In BoundingBox {-eps, void_gap-eps, -eps, eps, R+void_gap+eps, R+eps};
// Symmetry plane z = 0
szf[] = Surface In BoundingBox {-eps, -Hf-eps, -eps, W+eps, eps, eps};
szv[] = Surface In BoundingBox {-eps, -eps, -eps, r_c+eps, z_cap+eps, eps};
szi[] = Surface In BoundingBox {-eps, void_gap-eps, -eps, R+eps, R+void_gap+eps, eps};
// Bottom of the foundation and top of the indenter
fbt[] = Surface In BoundingBox {-eps, -Hf-eps, -eps, W+eps, -Hf+eps, W+eps};
itp[] = Surface In BoundingBox {-eps, R+void_gap-eps, -eps, R+eps, R+void_gap+eps, R+eps};

Physical Surface("FOUND_BOT", 200) = {fbt[]};
Physical Surface("SYM_FOUND_X", 201) = {sxf[]}; // x = 0
Physical Surface("SYM_IND_X", 202) = {sxi[]};   // x = 0
Physical Surface("IND_TOP", 203) = {itp[]};
Physical Surface("SYM_FOUND_Z", 204) = {szf[]}; // z = 0
Physical Surface("SYM_IND_Z", 205) = {szi[]};   // z = 0
Physical Surface("SYM_VOID_X", 206) = {sxv[]};  // x = 0
Physical Surface("SYM_VOID_Z", 207) = {szv[]};  // z = 0